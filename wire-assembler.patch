--- a/examples/riscv/rv32im.isa	1970-01-01 00:00:00.000000000 +0000
+++ b/examples/riscv/rv32im.isa	2026-10-31 22:26:54.254726925 +0000
@@ -0,0 +1,129 @@
+# RV32IM - the instruction set of examples/riscv, in the .isa language.
+# It describes what rvasm.js has written into its code: the same encodings,
+# the same pseudo-instructions, the same words out.
+
+isa "rv32im" (width = 32, unit = 8, endian = little)
+
+reg x[0..31]
+names zero, ra, sp, gp, tp, t0, t1, t2, s0, s1, a0, a1, a2, a3, a4, a5, a6, a7,
+      s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, t3, t4, t5, t6
+alias fp = s0
+
+data byte 1, half 2, word 4
+
+# %hi and %lo split a 32-bit value for lui + addi (the +0x800 makes up for
+# the sign of the low half)
+func %hi(x) = ((x + 0x800) >> 12) & 0xFFFFF
+func %lo(x) = %sext(x, 12)
+
+# ---- formats (bit 31 first) --------------------------------------------
+format R  = funct7:7 rs2:5 rs1:5 funct3:3 rd:5 opcode:7
+format I  = imm[11:0] rs1:5 funct3:3 rd:5 opcode:7
+format SH = funct7:7 shamt:5 rs1:5 funct3:3 rd:5 opcode:7
+format S  = imm[11:5] rs2:5 rs1:5 funct3:3 imm[4:0] opcode:7
+format B  = imm[12|10:5] rs2:5 rs1:5 funct3:3 imm[4:1|11] opcode:7
+format U  = imm[19:0] rd:5 opcode:7
+format J  = imm[20|10:1|11|19:12] rd:5 opcode:7
+
+# ---- RV32I and RV32M: register-register --------------------------------
+add    rd:reg, rs1:reg, rs2:reg = R(funct7 = 0x00, funct3 = 0, opcode = 0x33)
+sub    rd:reg, rs1:reg, rs2:reg = R(funct7 = 0x20, funct3 = 0, opcode = 0x33)
+sll    rd:reg, rs1:reg, rs2:reg = R(funct7 = 0x00, funct3 = 1, opcode = 0x33)
+slt    rd:reg, rs1:reg, rs2:reg = R(funct7 = 0x00, funct3 = 2, opcode = 0x33)
+sltu   rd:reg, rs1:reg, rs2:reg = R(funct7 = 0x00, funct3 = 3, opcode = 0x33)
+xor    rd:reg, rs1:reg, rs2:reg = R(funct7 = 0x00, funct3 = 4, opcode = 0x33)
+srl    rd:reg, rs1:reg, rs2:reg = R(funct7 = 0x00, funct3 = 5, opcode = 0x33)
+sra    rd:reg, rs1:reg, rs2:reg = R(funct7 = 0x20, funct3 = 5, opcode = 0x33)
+or     rd:reg, rs1:reg, rs2:reg = R(funct7 = 0x00, funct3 = 6, opcode = 0x33)
+and    rd:reg, rs1:reg, rs2:reg = R(funct7 = 0x00, funct3 = 7, opcode = 0x33)
+mul    rd:reg, rs1:reg, rs2:reg = R(funct7 = 0x01, funct3 = 0, opcode = 0x33)
+mulh   rd:reg, rs1:reg, rs2:reg = R(funct7 = 0x01, funct3 = 1, opcode = 0x33)
+mulhsu rd:reg, rs1:reg, rs2:reg = R(funct7 = 0x01, funct3 = 2, opcode = 0x33)
+mulhu  rd:reg, rs1:reg, rs2:reg = R(funct7 = 0x01, funct3 = 3, opcode = 0x33)
+div    rd:reg, rs1:reg, rs2:reg = R(funct7 = 0x01, funct3 = 4, opcode = 0x33)
+divu   rd:reg, rs1:reg, rs2:reg = R(funct7 = 0x01, funct3 = 5, opcode = 0x33)
+rem    rd:reg, rs1:reg, rs2:reg = R(funct7 = 0x01, funct3 = 6, opcode = 0x33)
+remu   rd:reg, rs1:reg, rs2:reg = R(funct7 = 0x01, funct3 = 7, opcode = 0x33)
