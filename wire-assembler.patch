+pseudo lb    rd:reg, t:b32         = auipc rd, %hi(t - pc) ; lb  rd, %lo(t - pc)(rd)
+pseudo lh    rd:reg, t:b32         = auipc rd, %hi(t - pc) ; lh  rd, %lo(t - pc)(rd)
