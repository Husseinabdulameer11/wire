+pseudo jal   t:rel21@2             = jal ra, t
+pseudo call  t:rel21@2             = jal ra, t
+pseudo tail  t:rel21@2             = jal x0, t
+pseudo jr    rs:reg                = jalr x0, 0(rs)
+pseudo jalr  rs:reg                = jalr ra, 0(rs)
+pseudo ret                         = jalr x0, 0(ra)
