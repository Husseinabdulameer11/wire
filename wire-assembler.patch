+    page.reset();
+    buildListing(r.listing);
+    ranProgram = current;
+    const what = `${r.text.length} instruction${r.text.length === 1 ? "" : "s"}${r.data.length ? `, ${r.data.length} bytes of data` : ""}`;
+    if (run) {
+      if (asm.speed) page.speed(asm.speed);
+      page.run(true);
