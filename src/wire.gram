# Wire - a language for describing digital circuits (wire.c).
# Semicolons are optional; `#` and `//` start comments.

program  <- stmt* ;
stmt     <^ title / import / component / cpu / decl / assign / connect ;

title    <- ~CIRCUIT string ~';'? ;
import   <- ~IMPORT string ~';'? ;

# component full_adder(a, b, cin) -> (s, cout) { ... }
# Port widths are part of the contract: x[4] must be connected to 4 bits.
component <- ~COMPONENT ident plist ~'->' (plist / pdecl) body ;
plist    <- ~'(' (pdecl (~',' pdecl)*)? ~')' ;
pdecl    <- ident range? ;
body     <- ~'{' cstmt* ~'}' ;
cstmt    <^ decl / assign / connect ;

# cpu rv (isa = "rv32im.isa", text = instr, data = {ram_b24, ram_b16, ram_b8, ram_b0}, pc = pc)
# says which part is the program memory and which file describes the
# instructions, so the page can offer an assembler for this circuit.
# (cpu is not a keyword: a wire may still be called cpu.)
cpu      <- ~CPU ident ~'(' copt (~',' copt)* ~')' ~';'? ;
copt     <- ident ~'=' cval ;
cval     <^ list / number / string / ident ;
list     <- ~'{' ident (~',' ident)* ~'}' ;

# input a, b[4]      led ok, err (color = red)      clock clk (hz = 2)
# bus data[8]: a wire that several tri() outputs may drive
decl     <- dkind item (~',' item)* ~';'? ;
item     <- ident range? opts? ;
opts     <- ~'(' opt (~',' opt)* ~')' ;
opt      <- ident ~'=' (number / ident / string) ;

assign   <- target ~'=' !'=' expr ~';'? ;
connect  <- expr ~'->' target (~',' target)* ~';'? ;
target   <- ident range? ;
range    <- ~'[' number (~':' number)? ~']' ;

# Operators, loosest first: |  ^  &  ~
expr     <^ orx ;
orx      <^ xorx (~'|' xorx)* ;
xorx     <^ andx (~'^' andx)* ;
andx     <^ unary (~'&' unary)* ;
unary    <^ notx / post ;
notx     <- ~('~' / '!') unary ;
post     <^ primary (port / range)* ;
port     <- ~'.' ident ;
primary  <^ call / concat / number / ident / ~'(' expr ~')' ;
call     <- ident ~'(' (arg (~',' arg)*)? ~')' ;
arg      <^ named / expr ;
named    <- ident ~'=' !'=' (string / expr) ;   # string: rom(a, file = "prog.hex")
concat   <- ~'{' expr (~',' expr)* ~'}' ;

# ---- tokens ------------------------------------------------------------
number   <= '0b' [01_]+ / '0x' [0-9a-fA-F_]+ / [0-9]+ ;
string   <= '"' [^"\n]* '"' ;
ident    <= !keyword [A-Za-z_] [A-Za-z0-9_]* ;
dkind    <= ('input' / 'output' / 'wire' / 'led' / 'seg7' / 'hex'
            / 'button' / 'clock' / 'bus' / 'keypad') ![A-Za-z0-9_] ;
CIRCUIT  <= 'circuit' ![A-Za-z0-9_] ;
IMPORT   <= 'import' ![A-Za-z0-9_] ;
COMPONENT <= 'component' ![A-Za-z0-9_] ;
CPU      <= 'cpu' ![A-Za-z0-9_] ;
keyword  <= ('input' / 'output' / 'wire' / 'led' / 'seg7' / 'hex'
            / 'button' / 'clock' / 'bus' / 'keypad'
            / 'circuit' / 'import' / 'component') ![A-Za-z0-9_] ;

skip     <= ([ \t\r\n] / '#' [^\n]* / '//' [^\n]*)* ;
