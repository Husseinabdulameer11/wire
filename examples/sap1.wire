circuit "SAP-1, Ben Eater's 8-bit computer"

# An 8-bit computer in the style of Ben Eater's breadboard build of the
# SAP-1 (Malvino, Digital Computer Electronics). Every module puts its value
# on one shared 8-bit bus with tri(); the control word comes from a
# microcode ROM (sap1/microcode.hex), addressed by the instruction and the
# step. The program is in RAM (sap1/multiply.hex: 3 x 29, then halt).
# Run the clock (try 100x), or Step, and watch the output.
#
# Instructions: LDA n, ADD n, SUB n, STA n, LDI n, JMP n, JC n, JZ n, OUT, HLT
# (opcode in the high 4 bits, address or value in the low 4).

clock  clk (hz = 4)
button reset
output out[8]
hex    hi, lo
led    halted (color = red), carry (color = yellow), zero (color = green)

bus data[8]

# ---- modules ---------------------------------------------------------------

# a register that loads from the bus at the clock edge while `load` is 1,
# and puts its value on the bus while `oe` is 1
component register(d[8], load, oe, clk, rst) -> (q[8], out[8]) {
    q   = reg(d, clk, en = load, rst = rst)
    out = tri(q, oe)
}

# adds, or subtracts (a + ~b + 1) while sub is 1
component alu(a[8], b[8], sub) -> (sum[8], carry, zero) {
    s     = add(a, b ^ {sub, sub, sub, sub, sub, sub, sub, sub}, cin = sub)
    sum   = s
    carry = s.cout
    zero  = ~(s[7] | s[6] | s[5] | s[4] | s[3] | s[2] | s[1] | s[0])
}

# ---- clock and control -------------------------------------------------------

c    = clk & ~HLT                 # HLT stops the clock
# the step counts 0..4 on the falling edge, so the control lines are steady
# before the rising edge that the registers load on
step = counter(~c, bits = 3, load = step[2], d = 0, rst = reset)
cw   = rom({ir[7:4], step}, bits = 18, file = "sap1/microcode.hex")

FI  = cw[0]
J   = cw[1]
CO  = cw[2]
CE  = cw[3]
OI  = cw[4]
BI  = cw[5]
SU  = cw[6]
EO  = cw[7]
AO  = cw[8]
AI  = cw[9]
II  = cw[10]
IO  = cw[11]
RO  = cw[12]
RI  = cw[13]
MI  = cw[14]
HLT = cw[15]
JZ  = cw[16]
JC  = cw[17]

# ---- the data path -------------------------------------------------------------

jump = J | (JC & cf) | (JZ & zf)
pc   = counter(c, bits = 4, en = CE, load = jump, d = data[3:0], rst = reset)
data = tri({0b0000, pc}, CO)

mar  = reg(data[3:0], c, en = MI, rst = reset)
mem  = ram(mar, data, RI, c, file = "sap1/multiply.hex")
data = tri(mem, RO)

ir   = reg(data, c, en = II, rst = reset)
data = tri({0b0000, ir[3:0]}, IO)

a    = register(data, AI, AO, c, reset)
data = a.out
b    = reg(data, c, en = BI, rst = reset)

e    = alu(a.q, b, SU)
data = tri(e.sum, EO)
flags = reg({e.carry, e.zero}, c, en = FI, rst = reset)
cf   = flags[1]
zf   = flags[0]

out  = reg(data, c, en = OI, rst = reset)
hi   = out[7:4]
lo   = out[3:0]

halted = HLT
carry  = cf
zero   = zf
