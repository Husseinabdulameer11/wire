circuit "4-bit ALU from chips"

import "adders.wire"

input  x[4], y[4], op[2]
output result[4], carry, zero
hex    show

# op: 0 = add, 1 = and, 2 = or, 3 = xor
s      = add4(x, y, 0)
result = mux(s, x & y, x | y, x ^ y, sel = op)
carry  = s.cout & ~op[1] & ~op[0]
zero   = ~(result[3] | result[2] | result[1] | result[0])
result -> show
