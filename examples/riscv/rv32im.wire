component alu(a[32], b[32], op[4], m) -> (y[32]) {
wire shamt[5]
wire dq[32], dr[32]
wire dsgn[1]
shamt = b[4:0]
dsgn = ~op[0]
dv = divider(a = a, b = b, sgn = dsgn)
dq = dv.q
dr = dv.r
ops = ops(a = a, b = b, shamt = shamt, op = op, dq = dq, dr = dr, m = m)
y = ops.y
}
