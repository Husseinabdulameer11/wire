component io(d_wdata[32], io_we, d_addr[32], reset, clk, sys) -> (disp_r[32], halt_r, cycles[32]) {
disp_r = dff(mux(mux(disp_r, d_wdata, sel = io_we & compare(d_addr[4:2], 0b000).eq), 0x00000000, sel = reset), clk)
halt_r = dff(mux(mux(halt_r, 0b1, sel = (io_we & compare(d_addr[4:2], 0b001).eq & d_wdata[0]) | sys), 0b0, sel = reset), clk)
cycles = dff(mux(mux(cycles, add(cycles, 0x00000001), sel = ~halt_r), 0x00000000, sel = reset), clk)
}
