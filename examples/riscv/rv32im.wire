imm = mux(mux(mux(mux(mux(0x00000000, {sign, instr[31:20]}, sel = (compare(opcode, 0b0000011).eq | compare(opcode, 0b0010011).eq | compare(opcode, 0b1100111).eq)), {sign, instr[31:25], instr[11:7]}, sel = compare(opcode, 0b0100011).eq), {sign[18:0], instr[31], instr[7], instr[30:25], instr[11:8], 0b0}, sel = compare(opcode, 0b1100011).eq), {instr[31:12], 0x000}, sel = (compare(opcode, 0b0110111).eq | compare(opcode, 0b0010111).eq)), {sign[10:0], instr[31], instr[19:12], instr[20], instr[30:21], 0b0}, sel = compare(opcode, 0b1101111).eq)
}
component decoder_(instr[32]) -> (reg_write, alu_src, alu_op[4], m_ext, a_pc, mem_read, mem_write, branch, jump, jalr, sys) {
wire opcode[7]
wire f3[3]
wire f7b[1]
opcode = instr[6:0]
f3 = instr[14:12]
f7b = instr[30]
m_ext = compare(opcode, 0b0110011).eq & instr[25]
wire v117_[1]
v117_ = mux(mux(compare(opcode, 0b1110011).eq, 0b0, sel = compare(opcode, 0b1100111).eq), 0b0, sel = compare(opcode, 0b1101111).eq)
wire v118_[1]
v118_ = mux(mux(compare(opcode, 0b1100111).eq, 0b1, sel = compare(opcode, 0b1101111).eq), 0b1, sel = compare(opcode, 0b0010111).eq)
wire v119_[1]
v119_ = mux(mux(compare(opcode, 0b1100111).eq, 0b0, sel = compare(opcode, 0b1101111).eq), 0b1, sel = compare(opcode, 0b0010111).eq)
wire v120_[1]
v120_ = mux(mux(compare(opcode, 0b1100111).eq, 0b0, sel = compare(opcode, 0b1101111).eq), 0b0, sel = compare(opcode, 0b0010111).eq)
wire v121_[1]
v121_ = mux(mux(compare(opcode, 0b1101111).eq, 0b0, sel = compare(opcode, 0b0010111).eq), 0b0, sel = compare(opcode, 0b0110111).eq)
wire v122_[1]
v122_ = mux(mux(compare(opcode, 0b0010111).eq, 0b0, sel = compare(opcode, 0b0110111).eq), 0b0, sel = compare(opcode, 0b1100011).eq)
wire v123_[1]
v123_ = mux(mux(mux(v117_, 0b0, sel = compare(opcode, 0b0010111).eq), 0b0, sel = compare(opcode, 0b0110111).eq), 0b0, sel = compare(opcode, 0b1100011).eq)
wire v124_[1]
v124_ = mux(mux(mux(v118_, 0b1, sel = compare(opcode, 0b0110111).eq), 0b0, sel = compare(opcode, 0b1100011).eq), 0b0, sel = compare(opcode, 0b0100011).eq)
wire v125_[1]
v125_ = mux(mux(mux(v119_, 0b1, sel = compare(opcode, 0b0110111).eq), 0b0, sel = compare(opcode, 0b1100011).eq), 0b1, sel = compare(opcode, 0b0100011).eq)
wire v126_[4]
v126_ = mux(mux(mux(0b0000, 0b1111, sel = compare(opcode, 0b0110111).eq), 0b0000, sel = compare(opcode, 0b1100011).eq), 0b0000, sel = compare(opcode, 0b0100011).eq)
wire v127_[1]
v127_ = mux(mux(mux(v120_, 0b0, sel = compare(opcode, 0b0110111).eq), 0b0, sel = compare(opcode, 0b1100011).eq), 0b0, sel = compare(opcode, 0b0100011).eq)
wire v128_[1]
v128_ = mux(mux(compare(opcode, 0b1100011).eq, 0b0, sel = compare(opcode, 0b0100011).eq), 0b0, sel = compare(opcode, 0b0000011).eq)
wire v129_[1]
v129_ = mux(mux(mux(v121_, 0b0, sel = compare(opcode, 0b1100011).eq), 0b0, sel = compare(opcode, 0b0100011).eq), 0b0, sel = compare(opcode, 0b0000011).eq)
wire v130_[4]
v130_ = mux(mux(v126_, 0b0000, sel = compare(opcode, 0b0000011).eq), mux({0b0, f3}, {f7b, f3}, sel = compare(f3, 0b101).eq), sel = compare(opcode, 0b0010011).eq)
wire v131_[1]
v131_ = mux(mux(mux(v122_, 0b0, sel = compare(opcode, 0b0100011).eq), 0b0, sel = compare(opcode, 0b0000011).eq), 0b0, sel = compare(opcode, 0b0010011).eq)
wire v132_[1]
v132_ = mux(mux(compare(opcode, 0b0100011).eq, 0b0, sel = compare(opcode, 0b0000011).eq), 0b0, sel = compare(opcode, 0b0010011).eq)
wire v133_[1]
v133_ = mux(mux(mux(v123_, 0b0, sel = compare(opcode, 0b0100011).eq), 0b0, sel = compare(opcode, 0b0000011).eq), 0b0, sel = compare(opcode, 0b0010011).eq)
reg_write = mux(mux(mux(v124_, 0b1, sel = compare(opcode, 0b0000011).eq), 0b1, sel = compare(opcode, 0b0010011).eq), 0b1, sel = compare(opcode, 0b0110011).eq)
alu_src = mux(mux(mux(v125_, 0b1, sel = compare(opcode, 0b0000011).eq), 0b1, sel = compare(opcode, 0b0010011).eq), 0b0, sel = compare(opcode, 0b0110011).eq)
alu_op = mux(v130_, {f7b, f3}, sel = compare(opcode, 0b0110011).eq)
a_pc = mux(v131_, 0b0, sel = compare(opcode, 0b0110011).eq)
mem_read = mux(mux(compare(opcode, 0b0000011).eq, 0b0, sel = compare(opcode, 0b0010011).eq), 0b0, sel = compare(opcode, 0b0110011).eq)
mem_write = mux(v132_, 0b0, sel = compare(opcode, 0b0110011).eq)
branch = mux(mux(v128_, 0b0, sel = compare(opcode, 0b0010011).eq), 0b0, sel = compare(opcode, 0b0110011).eq)
jump = mux(mux(v129_, 0b0, sel = compare(opcode, 0b0010011).eq), 0b0, sel = compare(opcode, 0b0110011).eq)
jalr = mux(mux(mux(v127_, 0b0, sel = compare(opcode, 0b0000011).eq), 0b0, sel = compare(opcode, 0b0010011).eq), 0b0, sel = compare(opcode, 0b0110011).eq)
sys = mux(v133_, 0b0, sel = compare(opcode, 0b0110011).eq)
}
component cpu(clk, reset, halt, instr[32], d_rdata[32]) -> (pc_out[32], d_addr[32], d_wdata[32], d_be[4], sys) {
wire pc[32]
wire pc4[32], next_pc[32], imm[32], rd1[32], rd2[32], alu_a[32], alu_b[32], alu_y[32], wb[32]
wire reg_write[1], rf_we[1], alu_src[1], m_ext[1], a_pc[1], mem_read[1], mem_write[1], branch[1], jump[1], jalr[1]
wire alu_op[4]
wire f3[3]
wire take[1]
wire ld_shift[32], ld_val[32]
f3 = instr[14:12]
dec = decoder_(instr = instr)
reg_write = dec.reg_write
alu_src = dec.alu_src
alu_op = dec.alu_op
m_ext = dec.m_ext
a_pc = dec.a_pc
mem_read = dec.mem_read
mem_write = dec.mem_write
branch = dec.branch
jump = dec.jump
jalr = dec.jalr
sys = dec.sys
ig = imm_gen(instr = instr)
imm = ig.imm
rf_we = reg_write & ~halt
rf = regfile(clk = clk, we = rf_we, rs1 = instr[19:15], rs2 = instr[24:20], rd = instr[11:7], wd = wb)
rd1 = rf.rd1
rd2 = rf.rd2
alu_a = mux(rd1, pc, sel = a_pc)
alu_b = mux(rd2, imm, sel = alu_src)
ex = alu(a = alu_a, b = alu_b, op = alu_op, m = m_ext)
alu_y = ex.y
branch_cond = branch_cond(rd1 = rd1, rd2 = rd2, f3 = f3)
take = branch_cond.take
pc4 = add(pc, 0x00000004)
next_pc = mux(mux(pc4, add(pc, imm), sel = jump | (branch & take)), {alu_y[31:1], 0b0}, sel = jalr)
pc = dff(mux(mux(pc, next_pc, sel = ~halt), 0x00000000, sel = reset), clk)
pc_out = pc
d_addr = alu_y
d_wdata = mux({rd2[7:0], rd2[7:0], rd2[7:0], rd2[7:0]}, {rd2[15:0], rd2[15:0]}, rd2, rd2, sel = f3[1:0])
wire v134_[4]
v134_ = mux(mux(0b0001, 0b0010, 0b0100, 0b1000, sel = alu_y[1:0]), mux(0b1100, 0b0011, sel = ~alu_y[1]), 0b1111, 0b1111, sel = f3[1:0])
d_be = mux(0b0000, v134_, sel = mem_write & ~halt)
ld_shift = mux(d_rdata, {0x00, d_rdata[31:8]}, {0x0000, d_rdata[31:16]}, {0x000000, d_rdata[31:24]}, sel = alu_y[1:0])
ld_val = mux({ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0][7], ld_shift[7:0]}, {ld_shift[15:0][15], ld_shift[15:0][15], ld_shift[15:0][15], ld_shift[15:0][15], ld_shift[15:0][15], ld_shift[15:0][15], ld_shift[15:0][15], ld_shift[15:0][15], ld_shift[15:0][15], ld_shift[15:0][15], ld_shift[15:0][15], ld_shift[15:0][15], ld_shift[15:0][15], ld_shift[15:0][15], ld_shift[15:0][15], ld_shift[15:0][15], ld_shift[15:0]}, ld_shift, ld_shift, {0x000000, ld_shift[7:0]}, {0x0000, ld_shift[15:0]}, ld_shift, ld_shift, sel = f3)
wb = mux(mux(alu_y, ld_val, sel = mem_read), pc4, sel = jump | jalr)
}
circuit "A RISC-V computer"

# An RV32IM processor (all of RV32I, and RV32M's multiply and divide) with
# its program in a rom, 4 KB of ram, a 64 x 64 colour screen, a 64 x 16
# text screen, a hex display, switches and a keypad. Assembly opens an
# assembler: pick a program or write your own, Assemble and run, and watch
# it on the screens. The rom starts with hello.s. Double-click core to go
# inside the processor; rv32im.vhd beside this file has the memory map.
clock clk
input reset
input sw[8]
keypad key
output display[32]
output halted
output pc[32]
wire ram_b0[8], ram_b8[8], ram_b16[8], ram_b24[8]
wire pixels[8]
wire chars[8]
cpu rv32im (isa = "rv32im.isa", text = instr, data = {ram_b24, ram_b16, ram_b8, ram_b0}, data_base = 0x1000, pc = pc, halt = halted, regs = "regs_%d")
wire pc_i[32], instr[32], d_addr[32], d_wdata[32], d_rdata[32], ram_q[32]
wire d_be[4]
wire sys[1], halt[1]
wire area[4]
wire word[10]
wire px_at[12]
wire ch_at[10]
wire px_q[8], ch_q[8], st_byte[8]
wire io_we[1]
wire disp_r[32]
wire halt_r[1]
wire cycles[32]
