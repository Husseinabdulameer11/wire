component branch_cond(rd1[32], rd2[32], f3[3]) -> (take) {
take = mux(compare(rd1, rd2).eq, ~compare(rd1, rd2).eq, 0b0, 0b0, compare({~rd1[31], rd1[30:0]}, {~rd2[31], rd2[30:0]}).lt, ~compare({~rd1[31], rd1[30:0]}, {~rd2[31], rd2[30:0]}).lt, compare(rd1, rd2).lt, ~compare(rd1, rd2).lt, sel = f3)
