circuit "BCD to 7-segment, from gates"

# What a 7447 does: a decimal digit (0 to 9) in, the seven segments a..g
# out, each one a sum of products found with a Karnaugh map (the codes
# 10 to 15 never happen, so they are don't-cares and the maps get
# simpler). disp[0] is segment a ... disp[6] is g, 1 = lit.

input  v[4]
seg7   disp

a = v[3]; b = v[2]; c = v[1]; d = v[0]

disp[0] = a | c | (b & d) | (~b & ~d)                            # segment a
disp[1] = ~b | (~c & ~d) | (c & d)                               # b
disp[2] = b | ~c | d                                             # c
disp[3] = a | (~b & ~d) | (~b & c) | (c & ~d) | (b & ~c & d)     # d
disp[4] = (~b & ~d) | (c & ~d)                                   # e
disp[5] = a | (~c & ~d) | (b & ~c) | (b & ~d)                    # f
disp[6] = a | (~b & c) | (b & ~c) | (c & ~d)                     # g
