circuit "4-request priority encoder"

# Chu, Listings 3.1, 3.3, 3.5 and 3.7: four requests r(4) .. r(1), r(4)
# the most important; pcode is the number of the highest one asking, 0 if
# none. As gates: bit 2 is r(4); bit 1 is "not r(4), and r(3) or r(2)";
# bit 0 is "not r(4), and r(3), or not r(2) and r(1)". Here r[3] is r(4)
# and r[0] is r(1).

input  r[4]
output pcode[3]

pcode[2] = r[3]
pcode[1] = ~r[3] & (r[2] | r[1])
pcode[0] = ~r[3] & (r[2] | (~r[1] & r[0]))
