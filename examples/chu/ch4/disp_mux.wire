circuit "LED time-multiplexing"

# Chu, Listing 4.13: the board has four seven-segment displays but only one
# set of segment wires. A counter takes turns: for a quarter of the time
# display 0 is on (its an line low) and sseg carries in0, then display 1
# with in1, and so on, fast enough that the eye sees all four at once.
# The two top bits of the counter pick the display.
#
# Chu's counter has 18 bits (about 800 Hz at 50 MHz); here it has 4, so
# the turns are easy to watch. an is active low, like the board.

clock  clk (hz = 8)
button reset
input  in3[8], in2[8], in1[8], in0[8]
output an[4], sseg[8]

wire   q[4]
q    = dff(add(q, 1), clk, rst = reset)
sel  = q[3:2]
an   = mux(0b1110, 0b1101, 0b1011, 0b0111, sel = sel)
sseg = mux(in0, in1, in2, in3, sel = sel)
